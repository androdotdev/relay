{
  "name": "@androff/relay-cli",
  "version": "1.0.0-beta.10",
  "description": "Relay — CLI tool to publish/update/list pages",
  "license": "MIT",
  "keywords": [
    "relay",
    "html",
    "pages",
    "cli",
    "mcp"
  ],
  "homepage": "https://posthtml.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/androdotdev/relay.git"
  },
  "type": "module",
  "bin": {
    "relay": "dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"No linter configured\" && exit 0"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "chalk": "5",
    "commander": "^15.0.0",
    "linkedom": "^0.18.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
